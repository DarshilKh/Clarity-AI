# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Get free at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Change to your production URL on deploy:
# NEXT_PUBLIC_APP_URL=https://clarity.netlify.app

# ─── OAuth (optional — configure in Supabase dashboard) ───────────────────────
# Google: Supabase Dashboard → Auth → Providers → Google
# GitHub: Supabase Dashboard → Auth → Providers → GitHub
# No extra env vars needed — handled by Supabase
